{
  "permissions": {
    "allow": ["Bash(butler-task:*)", "Bash(herdr:*)", "Read"],
    "deny": ["Edit", "Write", "NotebookEdit"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "command": "butler-task list --for-hook" }]
      }
    ]
  }
}
