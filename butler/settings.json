{
  "permissions": {
    "allow": ["Bash(bin/task:*)", "Bash(herdr:*)", "Read"],
    "deny": ["Edit", "Write", "NotebookEdit"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/bin/task list --for-hook" }]
      }
    ]
  }
}
