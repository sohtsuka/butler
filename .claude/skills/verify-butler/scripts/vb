#!/usr/bin/env bash
# vb: drive an isolated copy of butler for verification. See ../SKILL.md.
#   vb launch                      create a run, print its RUN_DIR
#   vb doctor  RUN_DIR             read-only: is this run worth driving?
#   vb run     RUN_DIR NAME -- CMD record CMD (stdin passes through) as artifacts/NAME.log
#   vb butler  RUN_DIR             start this run's butler agent (bin/butler, from here)
#   vb butler-here RUN_DIR         run bin/butler in a shell pane of the run, as the operator does
#   vb say     RUN_DIR NAME TEXT   prompt the run's butler, wait for its turn, save its screen
#   vb settle  RUN_DIR NAME SECS [MAX]  wait until the run's butler stays idle/done SECS s (give up after MAX, default 600), save its screen
#   vb cleanup RUN_DIR             tear down everything the run made; keep artifacts/
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
# Runs live next to the checkout (its parent dir should be Claude-trusted), outside any git repo.
# Override with VB_ROOT.
ROOT="${VB_ROOT:-$(dirname "$SRC")/.butler-verify}"

die() { echo "vb: $*" >&2; exit 1; }
load() {
  RUN_DIR="${1:?RUN_DIR required}"
  [[ -f "$RUN_DIR/env" ]] || die "$RUN_DIR is not a vb run"
  # The caller's own workspace. env names the run's RUN_WORKSPACE_ID, not HERDR_WORKSPACE_ID,
  # so a caller that sources env keeps its own id.
  CALLER_WORKSPACE_ID="${HERDR_WORKSPACE_ID:-}"
  RUN_WORKSPACE_ID=""   # a run made before dedicated workspaces has none; never fall back to the caller's
  # shellcheck disable=SC1091
  source "$RUN_DIR/env"
  unset HERDR_WORKSPACE_ID
  [[ -n "$RUN_WORKSPACE_ID" ]] && export HERDR_WORKSPACE_ID="$RUN_WORKSPACE_ID"
  # bin/task and bin/butler open tabs in $HERDR_WORKSPACE_ID, so this keeps every
  # tab the run makes inside the run's own workspace, away from the operator's tabs.
  export BUTLER_NAME PATH="$RUN_DIR/app/bin:$PATH"
}
herdr_json() { herdr "$@" 2>/dev/null || true; }

cmd_launch() {
  [[ -n "${HERDR_ENV:-}" ]] || die "run inside herdr (HERDR_ENV unset)"
  local id; id="$(date +%Y%m%d-%H%M%S)-$$"
  local run="$ROOT/$id"
  # Fixture names carry the run id: herdr puts worktrees at ~/.herdr/worktrees/<repo-name>/<branch>,
  # so a shared name would collide across concurrent runs.
  local git="$run/git-$id" plain="$run/plain-$id"
  mkdir -p "$run/artifacts" "$plain"
  # Copy the working tree, not HEAD, so uncommitted changes are what gets verified.
  mkdir -p "$run/app"; cp -r "$SRC/bin" "$SRC/butler" "$run/app/"
  git init -q "$git"
  git -C "$git" -c user.name=vb -c user.email=vb@localhost commit -q --allow-empty -m init
  # A dedicated workspace for the run's tabs (plain-dir workers, the run's butler).
  local ws
  ws="$(herdr workspace create --cwd "$run" --label "vb-$id" --no-focus | jq -r '.result.workspace.workspace_id')"
  [[ -n "$ws" && "$ws" != null ]] || die "could not create the run workspace"
  cat >"$run/env" <<EOF
RUN_ID=$id
BUTLER_NAME=vb$id
SRC=$SRC
FIXTURE_GIT=$git
FIXTURE_PLAIN=$plain
RUN_WORKSPACE_ID=$ws
EOF
  echo "$run"
}

cmd_doctor() {
  load "$1"; local ok=1
  check() { if eval "$2" >/dev/null 2>&1; then echo "ok    $1"; else echo "FAIL  $1"; ok=0; fi; }
  check "inside herdr" '[[ -n "${HERDR_ENV:-}" && -n "$CALLER_WORKSPACE_ID" ]]'
  check "run workspace exists" '[[ -n "${HERDR_WORKSPACE_ID:-}" ]] && herdr workspace get "$HERDR_WORKSPACE_ID"'
  check "run workspace is not the caller's" '[[ "${HERDR_WORKSPACE_ID:-}" != "$CALLER_WORKSPACE_ID" ]]'
  check "herdr server running" 'herdr status server | grep -q "status: running"'
  check "app copy matches working tree" 'diff -r "$SRC/bin" "$RUN_DIR/app/bin" -x __pycache__ && diff -r "$SRC/butler" "$RUN_DIR/app/butler"'
  check "task CLI is the run copy" '[[ "$(command -v task)" == "$RUN_DIR/app/bin/task" ]]'
  check "fixture-git has a commit" 'git -C "$FIXTURE_GIT" rev-parse HEAD'
  check "agent namespace is not the live butler" '[[ "$BUTLER_NAME" != butler ]]'
  echo "info  herdr $(herdr --version | cut -d" " -f2), $(claude --version)"
  echo "info  run workspace=${HERDR_WORKSPACE_ID:-none} (caller: ${CALLER_WORKSPACE_ID:-none})"
  echo "info  BUTLER_NAME=$BUTLER_NAME  db=$RUN_DIR/app/state/butler.db"
  echo "info  run agents: $(herdr agent list | jq -r --arg n "$BUTLER_NAME" '[.result.agents[] | select((.name // "") | startswith($n)) | "\(.name)=\(.agent_status)"] | join(" ")')"
  [[ $ok == 1 ]] || die "doctor failed"
}

cmd_run() {
  load "$1"; local name="$2"; shift 2; [[ "${1:-}" == -- ]] && shift
  local log="$RUN_DIR/artifacts/$name.log" out err code
  out="$(mktemp)"; err="$(mktemp)"
  set +e; (cd "$RUN_DIR/app" && "$@") >"$out" 2>"$err"; code=$?; set -e
  { echo "\$ $*"; echo "--- stdout"; cat "$out"; echo "--- stderr"; cat "$err"; echo "--- exit $code"; } >"$log"
  cat "$out"; cat "$err" >&2; rm -f "$out" "$err"
  return "$code"
}

butler_pane() { herdr agent get "$BUTLER_NAME" | jq -r '.result.agent.pane_id'; }
save_screen() { herdr pane read "$(butler_pane)" --source recent-unwrapped --lines 80 >"$RUN_DIR/artifacts/$1.screen.txt"; }

cmd_butler() {
  load "$1"
  (cd "$RUN_DIR/app" && bin/butler) | tee -a "$RUN_DIR/artifacts/butler-launch.log"
}

# The operator's own path: a herdr pane at a shell prompt runs bin/butler, which takes that
# pane over instead of opening a tab. `vb butler` cannot show this: its output is piped, so
# bin/butler keeps the pipe's reader alive and uses the new-tab fallback.
cmd_butler_here() {
  load "$1"
  local log="$RUN_DIR/artifacts/butler-here.log" created pane tab waited=0
  created="$(herdr tab create --cwd "$RUN_DIR/app" --label "$BUTLER_NAME-shell" --no-focus \
    --env "BUTLER_NAME=$BUTLER_NAME" --workspace "$HERDR_WORKSPACE_ID")"
  pane="$(jq -r '.result.root_pane.pane_id' <<<"$created")"
  tab="$(jq -r '.result.tab.tab_id' <<<"$created")"
  [[ -n "$pane" && "$pane" != null ]] || die "could not create the shell pane"
  { echo "shell pane $pane (tab $tab) in workspace $HERDR_WORKSPACE_ID"
    echo "--- tabs before bin/butler"
    herdr tab list --workspace "$HERDR_WORKSPACE_ID" | jq -r '.result.tabs[].tab_id'; } >"$log"
  sleep 1   # let the pane's shell reach its prompt before typing at it
  herdr pane run "$pane" "bin/butler" >/dev/null
  # bin/butler execs claude in that pane; a detached rename loop names it once herdr sees it.
  until herdr agent get "$BUTLER_NAME" >/dev/null 2>&1; do
    (( waited < 180 )) || { cat "$log" >&2; die "no agent named $BUTLER_NAME after ${waited}s"; }
    sleep 1; waited=$((waited + 1))
  done
  { echo "--- tabs after bin/butler"
    herdr tab list --workspace "$HERDR_WORKSPACE_ID" | jq -r '.result.tabs[].tab_id'
    echo "--- agent get $BUTLER_NAME"
    herdr agent get "$BUTLER_NAME"; } >>"$log"
  cat "$log"
}

cmd_say() {
  load "$1"; local name="$2" text="$3"
  herdr agent prompt "$BUTLER_NAME" "$text" --wait --timeout 600000 >/dev/null
  save_screen "$name"; tail -n 40 "$RUN_DIR/artifacts/$name.screen.txt"
}

cmd_settle() {
  load "$1"; local name="$2" secs="$3" quiet=0 deadline=$((SECONDS + ${4:-600}))
  while (( quiet < secs )); do
    (( SECONDS < deadline )) || die "butler never stayed quiet ${secs}s; see \$VB doctor"
    # A finished turn settles as `done` or `idle`; both count as quiet.
    if [[ "$(herdr agent get "$BUTLER_NAME" | jq -r '.result.agent.agent_status')" =~ ^(idle|done)$ ]]; then
      quiet=$((quiet + 1)); else quiet=0; fi
    sleep 1
  done
  save_screen "$name"; tail -n 40 "$RUN_DIR/artifacts/$name.screen.txt"
}

cmd_cleanup() {
  load "$1"
  local db="$RUN_DIR/app/state/butler.db"
  if [[ -f "$db" ]]; then
    for id in $(python3 -c "import sqlite3,sys;[print(r[0]) for r in sqlite3.connect(sys.argv[1]).execute('SELECT id FROM tasks')]" "$db"); do
      (cd "$RUN_DIR/app" && bin/task close "$id" --remove-worktree) || true
    done
  fi
  local tab; tab="$(herdr_json agent get "$BUTLER_NAME" | jq -r '.result.agent.tab_id // empty')"
  [[ -n "$tab" ]] && herdr tab close "$tab" >/dev/null
  if [[ -n "${HERDR_WORKSPACE_ID:-}" && "$HERDR_WORKSPACE_ID" != "$CALLER_WORKSPACE_ID" ]]; then
    herdr workspace close "$HERDR_WORKSPACE_ID" >/dev/null 2>&1 || true
  fi
  # Also close workspaces whose every pane is inside this run (e.g. the repo-root workspace
  # `worktree create` opens). Never a workspace that also holds someone else's pane.
  herdr workspace list | jq -r '.result.workspaces[].workspace_id' | while read -r ws; do
    if herdr pane list --workspace "$ws" | jq -e --arg r "$RUN_DIR" '(.result.panes | length) > 0 and all(.result.panes[]; .cwd | startswith($r))' >/dev/null; then
      herdr workspace close "$ws" >/dev/null || true
    fi
  done
  rm -rf "$RUN_DIR/app" "$FIXTURE_GIT" "$FIXTURE_PLAIN"
  local left; left="$(herdr agent list | jq -r --arg n "$BUTLER_NAME" '[.result.agents[] | select((.name // "") | startswith($n))] | length')"
  [[ "$left" == 0 ]] || die "agents still alive under $BUTLER_NAME"
  echo "cleaned $RUN_DIR; evidence kept in $RUN_DIR/artifacts"
}

sub="${1:-}"; shift || true
case "$sub" in
  launch|doctor|run|butler|say|settle|cleanup) "cmd_$sub" "$@" ;;
  butler-here) cmd_butler_here "$@" ;;
  *) sed -n '2,11p' "$0"; exit 2 ;;
esac
